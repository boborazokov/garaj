# Copy to .env.development or .env — never commit real secrets.
NODE_ENV=development
PORT=7007

# Required — min 32 characters; app refuses to start without it
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long

DATABASE_URL=mongodb://127.0.0.1:27017/autorin

# Redis (local defaults). Managed free tiers (Upstash) need TLS:
# REDIS_HOST=....upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=...
# REDIS_TLS=true

# Comma-separated browser origins (required in production)
# ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# HTTP / GraphQL hardening
JSON_BODY_LIMIT=5mb
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COMPLEXITY=1000
GRAPHQL_MAX_QUERY_BYTES=64000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Introspection: default off in production/staging; set true only for local schema work
# GRAPHQL_INTROSPECTION=false
# HSTS: enable only behind HTTPS terminators in production
# ENABLE_HSTS=true

# Uploads (bytes)
UPLOAD_MAX_FILE_BYTES=10485760

# WebSocket — sliding-window handshake throttle
WS_MAX_CONNECTIONS_PER_USER=10
WS_HANDSHAKE_WINDOW_MS=10000
WS_HANDSHAKE_MAX_PER_WINDOW=20

# Swagger (off in production unless enabled)
# SWAGGER_ENABLED=false
# SWAGGER_USER=admin
# SWAGGER_PASSWORD=

# Firebase Admin (FCM push). Path relative to autorin-backend cwd, or absolute.
# Must match the Firebase project in my_auto google-services.json (myauto-45d57).
# FIREBASE_SERVICE_ACCOUNT_PATH=./myauto-45d57-firebase-adminsdk-fbsvc-4eaee083e6.json
# Or: FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY

# Debug REST (production)
# ALLOW_FIREBASE_DEBUG_ENDPOINT=false

# Access tokens. Legacy tokens with no expiry stay valid until this UTC instant, then must log in again.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=2592000000
LEGACY_ACCESS_TOKEN_UNTIL=2026-11-16T00:00:00.000Z

# SMS. development defaults to the terminal log. production requires http.
# SMS_PROVIDER=log
# SMS_HTTP_URL=https://sms.example.com/send
# SMS_HTTP_TOKEN=replace-with-provider-token
