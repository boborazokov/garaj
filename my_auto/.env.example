# Copy to `.env` for local runs. Never commit real `.env` values.
# Android emulator → host machine API: http://10.0.2.2:7007
# Physical device on LAN → http://<your-dev-machine-lan-ip>:7007
# iOS simulator → http://127.0.0.1:7007
# Desktop/web Flutter → http://127.0.0.1:7007

API_URL=http://127.0.0.1:7007
API_File_URL=http://127.0.0.1:7007
API_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# Optional map tiles (leave empty to disable map features that need it)
MAPTILER_API_KEY=

# Mongo ObjectId of the admin/support chat user (local/dev only)
ADMIN_USER_ID=

# Optional Telegram support / wallet top-up link
TELEGRAM_WALLET_URL=
